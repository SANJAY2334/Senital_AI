{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Application",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "incremental": true,
    "isolatedModules": true
  }
}
