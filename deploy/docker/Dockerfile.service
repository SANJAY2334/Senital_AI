# SentinelAI Production Microservice Dockerfile (Multi-Stage Build)
# Complies with ADR-0016 (Cloud-Agnostic Containers) and ADR-0011 (Zero-Trust Security)

# Stage 1: Build & Prune Dependencies
FROM node:20-alpine3.20 AS builder
WORKDIR /app
RUN npm install -g pnpm@8.15.4 turbo@1.12.4

# Copy monorepo configuration files
COPY package.json turbo.json pnpm-workspace.yaml* pnpm-lock.yaml* tsconfig.json* ./
COPY apps/ ./apps/
COPY services/ ./services/
COPY packages/ ./packages/
COPY contracts/ ./contracts/
COPY ml/ ./ml/
COPY tools/ ./tools/

# Prune monorepo for target microservice
ARG SERVICE_NAME
RUN turbo prune @sentinelai/${SERVICE_NAME} --docker

# Stage 2: Install dependencies & compile TypeScript
FROM node:20-alpine3.20 AS installer
WORKDIR /app
RUN npm install -g pnpm@8.15.4 turbo@1.12.4

ARG SERVICE_NAME

COPY --from=builder /app/pnpm-workspace.yaml* ./
COPY --from=builder /app/tsconfig.json* ./
COPY --from=builder /app/out/json/ ./
COPY --from=builder /app/out/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

COPY --from=builder /app/out/full/ ./
RUN turbo run build --filter=@sentinelai/${SERVICE_NAME}...

# Stage 3: Minimal Production Runtime
FROM node:20-alpine3.20 AS runner
WORKDIR /app

ARG SERVICE_NAME

# Security Hardening: Upgrade OS packages (ADR-0011) & Create non-root user
RUN apk upgrade --no-cache && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 sentinelai

COPY --from=installer /app/packages ./packages
COPY --from=installer /app/services/${SERVICE_NAME}/dist ./dist
COPY --from=installer /app/services/${SERVICE_NAME}/package.json ./package.json
COPY --from=installer /app/node_modules ./node_modules

# Set unprivileged security context
USER sentinelai

# Default environment & healthcheck parameters
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE ${PORT}

CMD ["node", "dist/index.js"]
