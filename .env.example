# SentinelAI Environment Variables Template
# Satisfies Environment Configuration Strategy (docs/architecture/Environment_Configuration_Strategy.md)
# DO NOT COMMIT PROD SECRETS OR REAL PRIVATE KEYS TO SOURCE CONTROL.

# =============================================================================
# 1. PLATFORM CORE & ENVIRONMENT HIERARCHY (REQUIRED)
# =============================================================================
NODE_ENV=local                       # Allowed: local, development, testing, staging, production
SERVICE_NAME=ingestion-collector     # Target microservice identifier
LOG_LEVEL=info                       # Allowed: debug, info, warn, error
PORT=8080                            # Listening port (1024-65535)

# =============================================================================
# 2. EVENT BUS & STREAMING INFRASTRUCTURE (REQUIRED)
# =============================================================================
KAFKA_BROKERS=localhost:9092          # Comma-separated streaming brokers (ADR-0004)
KAFKA_CLIENT_ID=sentinelai-local-bus  # Streaming client identifier

# =============================================================================
# 3. POLYGLOT STORAGE SUBSTRATE (REQUIRED / OPTIONAL DEFAULTS)
# =============================================================================
REDIS_GRAPH_ENDPOINT=localhost:6379   # In-memory temporal graph cache (ADR-0007, ADR-0008)
LAKEHOUSE_ENDPOINT=http://localhost:9000 # Columnar lakehouse storage (S3/MinIO)
CONFIG_STORE_ENDPOINT=localhost:8500  # Centralized dynamic key-value config store (ADR-0017)

# =============================================================================
# 4. SECURITY, ZERO-TRUST & KMS ENVELOPE ENCRYPTION (REQUIRED IN PROD)
# =============================================================================
MTLS_ENABLED=false                    # Set true in staging/production (ADR-0011)
KMS_PROVIDER=local-mock               # Allowed: local-mock, aws-kms, azure-keyvault, gcp-kms (ADR-0006)
KMS_MASTER_KEY_ID=dev-master-key-001 # Master KMS Key ID / ARN for envelope encryption
TLS_CERT_PATH=./packages/security/certs/dev-cert.pem
TLS_KEY_PATH=./packages/security/certs/dev-key.pem

# =============================================================================
# 5. OPENTELEMETRY OBSERVABILITY & DISTRIBUTED TRACING (OPTIONAL)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 # OpenTelemetry gRPC endpoint (ADR-0013)
OTEL_SERVICE_NAME=sentinelai-dev      # OpenTelemetry service identification label

# =============================================================================
# 6. RESILIENCE & CIRCUIT BREAKER PARAMETERS (OPTIONAL)
# =============================================================================
MAX_STREAM_RETRIES=3                 # Exponential backoff retry limit
CIRCUIT_BREAKER_TIMEOUT_MS=5000       # Latency threshold before circuit breaker trip
